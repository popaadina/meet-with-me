# Persistence in production (Upstash Redis REST, free tier). Without these, bookings go to .data/bookings.json (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: e-mail notification to you for each new booking (Resend).
RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=onboarding@resend.dev
